{
  "buildCommand": "CI=false npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://161.97.107.107:8080/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://161.97.107.107:8080/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
